{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(\"C:/Program Files/GitHub CLI/gh.exe\" pr create *)",
      "Bash(\"C:/Program Files/GitHub CLI/gh.exe\" pr edit *)",
      "Bash(\"C:/Program Files/GitHub CLI/gh.exe\" pr ready *)",
      "Bash(gh repo view *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx expo lint *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git remote -v)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(node .claude/skills/*)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npx expo-doctor *)",
      "Bash(npx expo config *)",
      "Bash(eas whoami)",
      "Bash(eas project:info)",
      "Bash(eas build:view *)",
      "Bash(eas build:list *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(gh pr merge *)",
      "Bash(\"C:/Program Files/GitHub CLI/gh.exe\" pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx expo install *)",
      "Bash(eas build *)",
      "Bash(npx eas build *)",
      "Bash(npm run build:dev *)",
      "Bash(npm run build:prod *)",
      "Bash(node scripts/build.mjs*)",
      "Bash(eas update*)",
      "Bash(eas channel*)",
      "Bash(npx eas update*)",
      "Bash(npx eas channel*)",
      "Bash(npm run update:dev*)",
      "Bash(npm run update:prod*)",
      "Bash(node scripts/update.mjs*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push -d*)",
      "PowerShell(git push * -d*)",
      "PowerShell(git push * :*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(git push --all*)",
      "PowerShell(git push * --all*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npx expo install *)",
      "PowerShell(eas build *)",
      "PowerShell(npx eas build *)",
      "PowerShell(npm run build:dev *)",
      "PowerShell(npm run build:prod *)",
      "PowerShell(node scripts/build.mjs*)",
      "PowerShell(eas update*)",
      "PowerShell(eas channel*)",
      "PowerShell(npx eas update*)",
      "PowerShell(npx eas channel*)",
      "PowerShell(npm run update:dev*)",
      "PowerShell(npm run update:prod*)",
      "PowerShell(node scripts/update.mjs*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking that main is not touched"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting and linting the file"
          }
        ]
      }
    ]
  }
}
