{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh repo view *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx expo lint *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git remote -v)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(node .claude/skills/*)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npx expo-doctor *)",
      "Bash(npx expo config *)",
      "Bash(eas whoami)",
      "Bash(eas project:info)",
      "Bash(eas build:view *)",
      "Bash(eas build:list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx expo install *)",
      "Bash(eas build *)",
      "Bash(npm run build:dev *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking that main is not touched"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting and linting the file"
          }
        ]
      }
    ]
  }
}
