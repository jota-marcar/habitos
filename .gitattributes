# Line endings: LF in the repository and in the working copy, on every system.
# Avoids spurious diffs between Windows and macOS and the "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Scripts that Windows needs with CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries: no conversion and no text diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
