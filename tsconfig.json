{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Deno, which runs the Edge Functions (supabase/functions), needs the extension of every
    // relative import.
    "allowImportingTsExtensions": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
